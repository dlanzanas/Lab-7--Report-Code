# Import necessary libraries
import pandas as pd
import numpy as np

# ---------------------------
# Bread Price Data Processing with Monthly Data
# --------------------------

def process_bread_prices_with_monthly():
    """
    Processes bread price data, including monthly values, calculates yearly averages,
    and predicts future prices while displaying monthly values.
    """
    # Bread price data including monthly values from 2012 to 2022
    bread_data = {
        "Year": [2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022],
        "Jan": [1.423, 1.422, 1.365, 1.479, 1.425, 1.351, 1.281, 1.274, 1.546, 1.555, 1.555],
        "Feb": [1.442, 1.411, 1.388, 1.435, 1.407, 1.358, 1.265, 1.282, 1.537, 1.578, 1.578],
        "Mar": [1.395, 1.412, 1.359, 1.444, 1.416, 1.329, 1.309, 1.261, 1.526, 1.607, 1.607],
        "Apr": [1.426, 1.409, 1.388, 1.454, 1.406, 1.328, 1.281, 1.285, 1.511, 1.612, 1.612],
        "May": [1.412, 1.401, 1.401, 1.463, 1.382, 1.327, 1.293, 1.289, 1.511, 1.606, 1.606],
        "Jun": [1.403, 1.439, 1.400, 1.467, 1.333, 1.335, 1.279, 1.280, 1.491, 1.691, 1.691],
        "Jul": [1.427, 1.434, 1.413, 1.447, 1.349, 1.327, 1.293, 1.281, 1.493, 1.715, 1.715],
        "Aug": [1.407, 1.408, 1.396, 1.420, 1.341, 1.348, 1.302, 1.296, 1.467, None, None],
        "Sep": [1.401, 1.419, 1.405, 1.432, 1.329, 1.349, 1.288, 1.296, 1.580, None, None],
        "Oct": [1.422, 1.358, 1.414, 1.418, 1.343, 1.328, 1.277, 1.325, 1.526, None, None],
        "Nov": [1.418, 1.382, 1.420, 1.409, 1.362, 1.295, 1.274, 1.361, 1.547, None, None],
        "Dec": [1.436, 1.385, 1.466, 1.428, 1.362, 1.316, 1.290, 1.363, 1.532, None, None]
    }

    # Convert dictionary to DataFrame
    bread_df = pd.DataFrame(bread_data)

    # Calculate the yearly average price
    bread_df["Yearly Avg Price"] = bread_df.iloc[:, 1:].mean(axis=1)

    # Convert years and yearly average prices to numpy arrays for trend analysis
    years = np.array(bread_df["Year"])
    prices = np.array(bread_df["Yearly Avg Price"])

    # Fit a linear regression model (trendline)
    coefficients = np.polyfit(years, prices, 1)  # 1st-degree polynomial (linear trend)
    trendline = np.poly1d(coefficients)

    # Generate future predictions for 2023 and 2024
    future_years = np.array([2023, 2024])
    future_prices = trendline(future_years)

    # Append future predictions to DataFrame
    future_df = pd.DataFrame({"Year": future_years, "Yearly Avg Price": future_prices})
    bread_df = pd.concat([bread_df, future_df], ignore_index=True)

    # Display bread price table with monthly values and yearly trends
    print("\nBread Price Data with Monthly Prices & Yearly Trend Visualization:\n")
    print(bread_df.to_string(index=False))

# Run the bread price processing function with monthly data
process_bread_prices_with_monthly()
